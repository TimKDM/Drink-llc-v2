<section class="dk-hs" id="dkhs-{{ section.id }}" data-interval="{{ section.settings.interval | times: 1000 }}" style="--dk-acc:{{ section.settings.accent }}">
  <div class="dk-hs__brand">{% render 'drink-mark', dot: section.settings.accent %}</div>
  <div class="dk-hs__slides">
    {% for block in section.blocks %}
      {% assign img = block.settings.asset_name | default: 'drink-hero-1.jpg' %}
      <div class="dk-hs__slide{% if forloop.first %} is-on{% endif %}{% if block.settings.keep_color %} dk-lstyle--warm{% endif %}" {{ block.shopify_attributes }}>
        {% if block.settings.image %}<img class="dk-lstyle__img" src="{{ block.settings.image | image_url: width: 2400 }}" alt="{{ block.settings.title | escape }}" {% unless forloop.first %}loading="lazy"{% endunless %}>{% else %}<img class="dk-lstyle__img" src="{{ img | asset_url }}" alt="{{ block.settings.title | escape }}" {% unless forloop.first %}loading="lazy"{% endunless %}>{% endif %}
        <div class="dk-hs__scrim"></div>
        <div class="dk-wrap dk-hs__c">
          {% if block.settings.kicker != blank %}<span class="dk-label">{{ block.settings.kicker }}</span>{% endif %}
          <h2 class="dk-bebas dk-hs__t">{{ block.settings.title }}</h2>
          {% if block.settings.cta != blank %}<a class="dk-btn" href="{{ block.settings.link | default: '/collections/all' }}">{{ block.settings.cta }}</a>{% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
  {% if section.blocks.size > 1 %}<div class="dk-hs__dots">{% for block in section.blocks %}<button class="dk-hs__dot{% if forloop.first %} is-on{% endif %}" type="button" aria-label="Slide {{ forloop.index }}"></button>{% endfor %}</div>{% endif %}
</section>
<script>
(function(){
  var r=document.getElementById('dkhs-{{ section.id }}'); if(!r) return;
  var s=[].slice.call(r.querySelectorAll('.dk-hs__slide')), d=[].slice.call(r.querySelectorAll('.dk-hs__dot'));
  if(s.length<2) return;
  var i=0, iv=parseInt(r.getAttribute('data-interval'))||6500, t;
  function go(n){ s[i].classList.remove('is-on'); if(d[i])d[i].classList.remove('is-on'); i=(n+s.length)%s.length; s[i].classList.add('is-on'); if(d[i])d[i].classList.add('is-on'); }
  function play(){ stop(); t=setInterval(function(){go(i+1);}, iv); }
  function stop(){ if(t) clearInterval(t); }
  d.forEach(function(b,n){ b.addEventListener('click',function(){ go(n); play(); }); });
  r.addEventListener('mouseenter',stop); r.addEventListener('mouseleave',play);
  play();
})();
</script>
{% schema %}
{
  "name":"DRiNK hero slider",
  "settings":[
    {"type":"range","id":"interval","min":4,"max":10,"step":1,"unit":"s","label":"Slide interval","default":6},
    {"type":"color","id":"accent","label":"Accent","default":"#FF8C42"}
  ],
  "blocks":[
    {"type":"slide","name":"Slide","settings":[
      {"type":"image_picker","id":"image","label":"Image (overrides bundled)"},
      {"type":"text","id":"asset_name","label":"Bundled image filename","default":"drink-hero-1.jpg"},
      {"type":"checkbox","id":"keep_color","label":"Keep full color (skip grade)","default":false},
      {"type":"text","id":"kicker","label":"Kicker"},
      {"type":"text","id":"title","label":"Headline","default":"One drink. Every you."},
      {"type":"text","id":"cta","label":"CTA","default":"Pick your flavor."},
      {"type":"url","id":"link","label":"Link"}
    ]}
  ],
  "max_blocks":5,
  "presets":[{"name":"DRiNK hero slider","blocks":[{"type":"slide"},{"type":"slide"},{"type":"slide"}]}]
}
{% endschema %}
