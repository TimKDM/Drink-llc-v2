{%- liquid
  assign h = product.handle | downcase
  assign acc = '#F5F5F0'
  if h contains 'lemonade'
    assign acc = '#FFE566'
  elsif h contains 'lychee'
    assign acc = '#FF9EBA'
  elsif h contains 'peach' or h contains 'mango'
    assign acc = '#FF8C42'
  elsif h contains 'passion'
    assign acc = '#C77DFF'
  elsif h contains 'matcha'
    assign acc = '#7CB518'
  elsif h contains 'creatine'
    assign acc = '#3BA7FF'
  endif
  assign cardcls = 'dk-card'
  if h contains 'creatine'
    assign cardcls = 'dk-card dk-card--creatine'
  endif
-%}
<a class="{{ cardcls }}" href="{{ product.url }}" style="--ca:{{ acc }}">
  <span class="dk-card__img">
    {% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 720 }}" alt="{{ product.title | escape }}" loading="lazy" width="720" height="720">{% else %}{% render 'drink-mark', dot: acc %}{% endif %}
  </span>
  <span class="dk-card__body">
    <span class="dk-card__flavor">{{ product.metafields.custom.flavor | default: product.title }}</span>
    <span class="dk-card__price">{{ product.price | money }}</span>
  </span>
  <span class="dk-card__cta">Add. Drink.</span>
</a>
